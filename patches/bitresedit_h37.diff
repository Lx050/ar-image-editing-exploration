     @torch.no_grad()
+    def _gated_decode(
+        self,
+        z_edit: torch.Tensor,
+        z_src: torch.Tensor,
+        gt_mask: torch.Tensor,
+        mix: float,
+    ) -> torch.Tensor:
+        """VAE decoder with bottleneck feature-space mask gating (batch 37).
+
+        Runs both code tensors through conv_in + mid to obtain the
+        bottleneck features, mixes them spatially with the downsampled GT
+        mask, then decodes the mixed feature map through the shared
+        up-sampling head. Returns image in [-1, 1] (clamped), matching
+        AutoEncoder.decode. gated = mix*m*h_edit + (1-mix*m)*h_src.
+        """
+        dec = self.vae.decoder
+
+        def _bottleneck(z: torch.Tensor) -> torch.Tensor:
+            h = dec.conv_in(z)
+            h = dec.mid.block_1(h)
+            if (
+                getattr(dec, "cnn_param", {}).get("cnn_attention", "no") == "yes"
+                and hasattr(dec.mid, "attn_1")
+            ):
+                h = dec.mid.attn_1(h)
+            h = dec.mid.block_2(h)
+            return h
+
+        h_e = _bottleneck(z_edit)
+        h_s = _bottleneck(z_src)
+        b, c, hf, wf = h_e.shape
+
+        m = gt_mask.float()
+        if m.ndim == 2:
+            m = m[None, None]
+        elif m.ndim == 3:
+            m = m[None]
+        m = F.interpolate(m, size=(hf, wf), mode="bilinear", align_corners=False)
+        m = m.to(h_e.dtype)
+
+        gated = mix * m * h_e + (1.0 - mix * m) * h_s
+
+        h = gated
+        for i_level in reversed(range(dec.num_resolutions)):
+            for i_block in range(dec.num_res_blocks + 1):
+                h = dec.up[i_level].block[i_block](h)
+                if len(dec.up[i_level].attn) > 0:
+                    h = dec.up[i_level].attn[i_block](h)
+            if hasattr(dec.up[i_level], "upsample"):
+                h = dec.up[i_level].upsample(h)
+        h = dec.norm_out(h)
+        h = F.silu(h)
+        h = dec.conv_out(h)
+        return torch.clamp(h, min=-1.0, max=1.0)
+
